# TEAM-PROJECT\server\.env    <---  path for this file

# *use command prompt*

# Run this code below after git pull: (might need to delete node_modules in both folders)

# cd server (backend)
# npm install
# npx prisma generate
# *open docker*
# npm run db:setup
# npx prisma studio (to see the db)
# *new cmd* (to see the frontend)
# cd client
# npm install
# npm run start
# *new cmd*
# cd server
# npm run dev

# Before working on the feature:
# git checkout main
# git checkout -b feature/name-of-feature
# git branch (should be * next to the one you just created)
# git push -u origin feature/name-of-feature
# git status (for validation)
# After you're done with the feature:
# git add .
# git commit -m "your commit message"
# go to the git and open pull request, then merge it if there are no conflicts
# Then go back to VSC 
# git checkout main
# git pull origin main
# git branch -d feature/name-of-feature

# OR could just:
# git add .
# git commit -m "name of commit"
# git push -u origin main
# NOT recommended (better to create a feature branch and let me review the code or yourself)

